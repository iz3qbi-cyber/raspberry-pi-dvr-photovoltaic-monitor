    "express": "^4.18.2",
    "node-onvif": "^0.1.4",
    "jsmodbus": "^4.0.6"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "keywords": [
    "raspberry-pi",
    "dvr",
    "onvif",
    "huawei",
    "solar",
    "photovoltaic",
    "modbus",
